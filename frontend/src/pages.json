{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^u--(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^up-(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^u-([^-].*)": "uview-plus/components/u-$1/u-$1.vue",
      "^(?!z-paging-refresh|z-paging-load-more)z-paging(.*)": "z-paging/components/z-paging$1/z-paging$1.vue",
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
    }
  },
  "pages": [
    {
      "name": "home",
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "识典古籍"
      }
    },
    {
      "name": "bookshelf",
      "path": "pages/bookshelf/index",
      "style": {
        "navigationBarTitleText": "我的书架"
      }
    },
    {
      "name": "category",
      "path": "pages/category/index",
      "style": {
        "navigationBarTitleText": "古籍分类"
      }
    },
    {
      "name": "mine",
      "path": "pages/mine/index",
      "style": {
        "navigationBarTitleText": "我的"
      }
    },
    {
      "name": "login",
      "path": "pages/login/index",
      "style": {
        "navigationBarTitleText": "登录"
      }
    },
    {
      "name": "book-detail",
      "path": "pages/book/detail",
      "style": {
        "navigationBarTitleText": "书目详情"
      }
    },
    {
      "name": "reader",
      "path": "pages/reader/index",
      "style": {
        "navigationBarTitleText": "阅读"
      }
    },
    {
      "name": "history",
      "path": "pages/history/index",
      "style": {
        "navigationBarTitleText": "阅读历史"
      }
    }
  ],
  "tabBar": {
    "color": "#999999",
    "selectedColor": "#8B5E3C",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页"
      },
      {
        "pagePath": "pages/bookshelf/index",
        "text": "书架"
      },
      {
        "pagePath": "pages/category/index",
        "text": "分类"
      },
      {
        "pagePath": "pages/mine/index",
        "text": "我的"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "识典古籍",
    "navigationBarBackgroundColor": "#F5EFE6",
    "backgroundColor": "#F8F6F1"
  }
}
